# ==============================================================================
# FITFLOW — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the actual credentials.
# NEVER commit the real .env file with production secrets.
# ==============================================================================

# Application Base URLs
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Auth.js / NextAuth)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"

# Database — Neon PostgreSQL
# DATABASE_URL: Pooled connection string for serverless runtime and web app (-pooler)
DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-2.aws.neon.tech/fitflow_db?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct unpooled connection string for Prisma CLI migrations
DIRECT_URL="postgresql://user:password@ep-cool.us-east-2.aws.neon.tech/fitflow_db?sslmode=require"

# Storage & Media — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="fitflow-media"
R2_PUBLIC_DOMAIN="https://media.fitflow.app"

# Application Environment
NODE_ENV="development"
